# Normalize all text files to LF in the repository and on checkout,
# regardless of a contributor's local core.autocrlf setting.
* text=auto eol=lf

# Explicitly binary — never normalize line endings or diff as text.
*.png binary
*.pdf binary
*.shp binary
*.shx binary
*.dbf binary

# Windows batch files need CRLF line endings to run reliably.
*.bat text eol=crlf

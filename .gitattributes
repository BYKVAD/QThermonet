# Normalize all text files to LF in the repository and on checkout,
# regardless of a contributor's local core.autocrlf setting.
* text=auto eol=lf

# Explicitly binary — never normalize line endings or diff as text.
*.png binary
*.pdf binary
*.shp binary
*.shx binary
*.dbf binary

# Left out of release zips (git archive)
.gitattributes export-ignore
.gitignore export-ignore
CONTRIBUTING.md export-ignore
Makefile export-ignore
pb_tool.cfg export-ignore
pylintrc export-ignore
help/ export-ignore
scripts/ export-ignore
Tutorial1/ export-ignore
